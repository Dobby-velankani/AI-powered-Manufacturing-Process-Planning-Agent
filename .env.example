# AI-powered Manufacturing Process Planning Agent - Environment Configuration
# Copy this file to .env and fill in your actual values

# Gemini API Configuration (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-pro,gemini-1.5-flash

# Optional: Custom SSL Certificate Bundle
# GEMINI_CA_BUNDLE=path/to/your/certificate.pem

# Optional: OpenAI API Configuration (for future multi-LLM support)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# Optional: Anthropic Claude Configuration (for future support)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-sonnet-20240229